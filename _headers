/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; manifest-src 'self'
  Cache-Control: public, max-age=300

# No /api/* rules here.
# Cloudflare Pages applies _headers only to static-asset responses. Pages
# Function responses (/api/*) set their own headers in functions/api/*.js —
# e.g. github-stats uses Cache-Control max-age=300.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# CSP is Report-Only: inline style/script on index.html require 'unsafe-inline'.
# Promote to Content-Security-Policy after console/report review (no report
# endpoint configured yet — avoid new third-party credentials).
