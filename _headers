/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=300

# No /api/* rules here.
# Cloudflare Pages applies _headers only to static-asset responses. Pages
# Function responses (/api/*) set their own headers in functions/api/*.js —
# e.g. github-stats uses Cache-Control max-age=300.
# https://developers.cloudflare.com/pages/configuration/headers/
