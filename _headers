/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; manifest-src 'self'

# HTML shell: short cache. Do not set Cache-Control on /* or asset
# rules append duplicate Cache-Control values in Pages/_headers merges.
/
  Cache-Control: public, max-age=300

/index.html
  Cache-Control: public, max-age=300

# Self-hosted fonts (immutable filenames).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Longer TTL for sized social/image assets (filenames are stable; bump when replaced).
/og-image.jpg
  Cache-Control: public, max-age=604800

/og-image.webp
  Cache-Control: public, max-age=604800

/og-image.avif
  Cache-Control: public, max-age=604800

/og-image-600.jpg
  Cache-Control: public, max-age=604800

/og-image-600.webp
  Cache-Control: public, max-age=604800

/og-image-600.avif
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=86400

/public/*
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# No /api/* rules here.
# Cloudflare Pages applies _headers only to static-asset responses. Pages
# Function responses (/api/*) set their own headers in functions/api/*.js —
# e.g. github-stats uses Cache-Control max-age=300.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# CSP is Report-Only: inline style on index.html still needs 'unsafe-inline';
# script-src 'self' covers deferred /assets/dashboard.js; font-src 'self'
# covers /fonts/*. Promote to Content-Security-Policy after console/report
# review (no report endpoint configured yet — avoid new third-party credentials).
